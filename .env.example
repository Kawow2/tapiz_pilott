# API_HOST/API_PORT are where the API process binds (use 0.0.0.0 in Docker).
API_HOST=localhost
API_PORT=8000

FRONTEND_HOST=localhost
FRONTEND_PORT=4300
FRONTEND_URL=http://${FRONTEND_HOST}:${FRONTEND_PORT}

# Browser-facing URLs. Point them at the FRONTEND origin: the web container's
# nginx already proxies /api and /socket.io to the API, so everything stays
# same-origin. Targeting the API port directly makes the WebSocket a
# cross-origin request to a private IP, which strict browsers (Chrome/Opera
# "Local Network Access" enterprise policy) block silently.
API_URL=http://${FRONTEND_HOST}:${FRONTEND_PORT}/api
WS_URL=ws://${FRONTEND_HOST}:${FRONTEND_PORT}

# if you are not using docker, change this to localhost
POSTGRES_HOST = db

POSTGRES_USER=tapiz_user
POSTGRES_PASSWORD=tapiz_password
POSTGRES_DB = tapiz

 # Docker db public port
POSTGRES_PORT_HOST = 5432

# Local-development AI screenshot login using a personal API token.
# The route is unavailable unless NODE_ENV=development.
AI_AGENT_LOGIN_ENABLED=false

# SMTP configuration for notification emails
# Replace with your SMTP server credentials
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Optional from address
SMTP_FROM=""
SMTP_SECURE=false
